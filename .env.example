# Copy this file to .env and fill in your own key.  .env is git-ignored: never commit it.
# Get a key at https://elevenlabs.io/app/settings/api-keys  (README § ElevenLabs setup)
ELEVENLABS_API_KEY=

# Optional
# REMOTION_CONCURRENCY=2    # render threads; use 1 on an 8 GB machine if renders fail
# REMOTION_CHUNK=900        # frames per render chunk (long videos are rendered in chunks and joined)
# ASR_BACKEND=              # mlx (Apple Silicon default) or faster-whisper (default elsewhere)
# WHISPER_MODEL=            # faster-whisper model, e.g. small on a slow CPU (default large-v3-turbo)
